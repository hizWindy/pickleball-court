# Copy to .env and adjust. Every value has a sensible default.

# Where the SQLite database and uploaded receipts live (keep it on a persistent disk and back it up)
# DATA_DIR=./data

# Payment accounts shown on the pay screen. A method with no number is shown as "coming soon".
GCASH_ACCOUNT_NAME=Reymark Vergara
GCASH_ACCOUNT_NUMBER=09128285344
GOTYME_ACCOUNT_NAME=Reymark Vergara
GOTYME_ACCOUNT_NUMBER=

# Booking rules
HOLD_MINUTES=15
MAX_HOURS=3
BOOKING_WINDOW_DAYS=30
MAX_HOLDS_PER_PHONE=1
MAX_HOLDS_PER_IP=2
PADDLE_FEE=80

# Bump when the Privacy Notice text changes; players must agree again.
CONSENT_VERSION=2026-10-v1
