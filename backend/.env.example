# Copy to .env and adjust. Every value has a sensible default.

# Where the SQLite database and uploaded receipts live (keep it on a persistent disk and back it up)
# DATA_DIR=./data

# Payment accounts shown on the pay screen. A method needs a number or a QR image to be offered;
# otherwise it shows as "coming soon". QR images live in frontend/public/images/.
GCASH_ACCOUNT_NAME=Reymark Vergara
GCASH_ACCOUNT_NUMBER=09128285344
GCASH_QR_IMAGE=/images/payment-qr-gcash.jpg
GOTYME_ACCOUNT_NAME=Rey Mark Vergara
GOTYME_ACCOUNT_NUMBER=
GOTYME_ACCOUNT_HINT=•••• 1204
GOTYME_QR_IMAGE=/images/payment-qr-gotyme.jpg

# Booking rules (comments must sit on their own line: the loader doesn't strip text after a value)
# Unpaid slots are freed after HOLD_MINUTES; the grace is a silent allowance for slow networks.
HOLD_MINUTES=10
HOLD_GRACE_SECONDS=10
MAX_HOURS=5
BOOKING_WINDOW_DAYS=30
MAX_HOLDS_PER_PHONE=1
MAX_HOLDS_PER_IP=2
PADDLE_FEE=80

# Late rule: a group not there this long after its start is Late and the court is released (house rule: 15).
LATE_AFTER_MINUTES=15
# The host (only) can still restore a Late booking for this many minutes after it went late. Guests are never told.
RESTORE_WINDOW_MINUTES=5
# Guests can check in on their pass from this long before the start.
CHECKIN_OPENS_MINUTES=30

# Rescheduling: once per booking, this many hours ahead, new date within this many days of the original.
RESCHEDULE_MIN_HOURS=48
RESCHEDULE_WINDOW_DAYS=30

# Rain forecast on the admin desk (Open-Meteo: free, no key). Defaults to Koronadal City.
# WEATHER_ENABLED=1
# WEATHER_LATITUDE=6.5031
# WEATHER_LONGITUDE=124.8469
# RAIN_WARN_PERCENT=60

# Optional Telegram alerts to the host: "X is late (restore it?)" and "rain expected on Saturday".
# Make a bot with @BotFather, send it a message, then put its token and your chat id here.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Bump when the Privacy Notice text changes; players must agree again.
CONSENT_VERSION=2026-10-v1

# Admin desk at /admin. Make a hash with:  python -m app.admin_auth
# Leave both empty and nobody can sign in. ADMIN_PASSWORD (plain text) is for quick local tests only.
# ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=
# ADMIN_SESSION_HOURS=168

# Read amount / reference / date / recipient off receipt images on this server (1 = on, 0 = off).
# OCR_ENABLED=1

# Receipt images: deleted this many days after the booking is confirmed or rejected (cap applies to older pending ones).
# RECEIPT_KEEP_AFTER_DECISION_DAYS=7
# RECEIPT_RETENTION_DAYS=14
